{
  "name": "you-doc-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic 2D-in-3D Three.js Cinema Documentary Engine — Why Airplane Windows Are Never Square",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "render:smoke": "node tools/render.mjs --mode=smoke",
    "render:chunk": "node tools/render.mjs --mode=chunk"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.0",
    "postprocessing": "^6.36.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "playwright": "^1.50.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
