{
  "name": "you-doc-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Map-Based Geography & Geopolitical Analysis -- deterministic video engine (Remotion + SVG geo)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:test": "remotion render src/index.ts TestShot out/test_shot.mp4 --gl=swangle --concurrency=2",
    "render:master": "remotion render src/index.ts Master out/master.mp4 --gl=swangle --concurrency=2",
    "still": "remotion still src/index.ts TestShot out/still.png --frame=45 --gl=swangle",
    "typecheck": "tsc --noEmit",
    "lint:shots": "python3 scripts/shot_lint.py",
    "lint:sync": "python3 scripts/check_sync.py",
    "qa": "npm run typecheck && npm run lint:shots && npm run lint:sync"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.539",
    "d3-geo": "3.1.1",
    "flag-icons": "^7.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "@types/react": "18.3.12",
    "@types/topojson-client": "3.1.5",
    "typescript": "5.9.3"
  }
}
